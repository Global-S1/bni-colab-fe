---
import '../styles/global.css';
import { MagicLoginForm } from '../components/auth/MagicLoginForm';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login | BNI Colab</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="min-h-screen flex items-center justify-center p-4 bg-[#0F0F12] relative overflow-hidden font-sans">
  <!-- Animated Background Layer from Eventos -->
  <div class="absolute inset-0 z-0">
    <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-[#D40000] opacity-20 blur-[120px] rounded-full animate-pulse"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-[#8B0000] opacity-20 blur-[120px] rounded-full animate-pulse" style="animation-delay: 2s;"></div>
  </div>

  <!-- Main Login Card Container -->
  <div class="w-full max-w-md z-10">
    <MagicLoginForm client:load />
  </div>
</body>
</html>

