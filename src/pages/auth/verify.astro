---
import Layout from '../../layouts/Layout.astro';
const apiUrl = import.meta.env.PUBLIC_API_URL || '/api-proxy/api/v1';
---

<Layout title="BNITECH Colab — Verificando Acceso">
  <div class="py-24 text-center space-y-4 max-w-md mx-auto bg-white p-8 rounded-2xl border border-gray-100 shadow-sm">
    <div class="w-10 h-10 border-4 border-[#D40000] border-t-transparent rounded-full animate-spin mx-auto"></div>
    <h2 class="text-xl font-bold text-gray-900">Verificando Enlace de Acceso...</h2>
    <p class="text-gray-500 text-xs">Aguarde un momento mientras iniciamos su sesión de manera segura.</p>
  </div>

  <script is:inline define:vars={{ apiUrl }}>
    const urlParams = new URLSearchParams(window.location.search);
    const token = urlParams.get('token');

    if (!token) {
      alert('Token de verificación no proporcionado.');
      window.location.href = '/login';
    } else {
      fetch(`${apiUrl}/auth/verify?token=${token}`)
        .then((res) => {
          if (!res.ok) throw new Error('Token inválido o expirado');
          return res.json();
        })
        .then((data) => {
          localStorage.setItem('bni_colab_token', data.accessToken);
          if (data.user) {
            localStorage.setItem('bni_colab_user', JSON.stringify(data.user));
          }
          window.location.href = '/teams';
        })
        .catch((err) => {
          alert('Error de autenticación: ' + err.message);
          window.location.href = '/login';
        });
    }
  </script>
</Layout>
